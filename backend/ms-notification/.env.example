ENV=development
LOG_LEVEL=info
PORT=3005
# Optional gRPC bind host (defaults to 127.0.0.1 in dev; set 0.0.0.0 in containers/prod)
# GRPC_BIND=127.0.0.1

INTERNAL_GRPC_TOKEN=dev-internal-grpc-token

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WiChat <noreply@example.com>
