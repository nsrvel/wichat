# ms-chat — copy to .env in this directory
ENV=development
LOG_LEVEL=info
PORT=3002

DATABASE_URL=postgres://wichat:wichat@localhost:5432/wichat?sslmode=disable
MS_USER_HOST=localhost:3001

KAFKA_BROKERS=localhost:9092
KAFKA_CHAT_EVENTS_TOPIC=chat-events
KAFKA_CONSUMER_GROUP=ms-chat-search-indexer

# Indexer runs on every message; search REST/UI is a later slice
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_MESSAGES_INDEX=wichat-messages

# Optional — channel file/image attachments (public bucket). Leave MINIO_ENDPOINT empty to disable uploads.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=wichat
# MINIO_SECRET_KEY=wichatdev
# MINIO_BUCKET=wichat-public
# MINIO_PUBLIC_BASE_URL=http://localhost:9000/wichat-public
# MINIO_USE_SSL=false
# MINIO_REGION=
