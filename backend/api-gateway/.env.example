# api-gateway — copy to .env in this directory (see backend/README.md)
ENV=development
LOG_LEVEL=info
PORT=3000
MS_USER_HOST=localhost:3001
MS_CHAT_HOST=localhost:3002
MS_NOTIFICATION_HOST=localhost:3005
WEB_ORIGIN=http://localhost:8080

KAFKA_BROKERS=localhost:9092
KAFKA_CHAT_EVENTS_TOPIC=chat-events
KAFKA_REALTIME_CONSUMER_GROUP=api-gateway-realtime
# INSTANCE_ID=  # optional; defaults to hostname for per-replica Kafka consumer groups

# Outbound gRPC client (utils.Settings)
MS_ATTEMPT_TIMEOUT_MS=5000
MS_OVERALL_TIMEOUT_MS=15000
MS_MAX_RETRIES=3
MS_RETRY_BACKOFF_MS=100
MS_BREAKER_FAILURE_THRESHOLD=5
MS_BREAKER_OPEN_MS=30000
