# Shared local dev for `make run` from backend/ — copy to backend/.env
# Matches deploy/docker-compose.yml. Per-service overrides: ms-*/.env

ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://wichat:wichat@localhost:5432/wichat?sslmode=disable
# Redis — ms-user only (not api-gateway / ms-chat)
REDIS_URL=redis://localhost:6379/0

# ms-user — min 32 chars
AUTH_JWT_SECRET=wichat-local-dev-jwt-secret-32b-min

MS_USER_HOST=localhost:3001
MS_CHAT_HOST=localhost:3002
MS_NOTIFICATION_HOST=localhost:3005
WEB_ORIGIN=http://localhost:8080

KAFKA_BROKERS=localhost:9092
KAFKA_CHAT_EVENTS_TOPIC=chat-events
KAFKA_CONSUMER_GROUP=ms-chat-search-indexer
KAFKA_REALTIME_CONSUMER_GROUP=api-gateway-realtime
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_MESSAGES_INDEX=wichat-messages

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=wichat
MINIO_SECRET_KEY=wichatdev
MINIO_BUCKET=wichat-public
MINIO_PUBLIC_BASE_URL=http://localhost:9000/wichat-public
MINIO_USE_SSL=false
