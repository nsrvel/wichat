# ms-core — copy to .env in this directory
ENV=development
LOG_LEVEL=info
PORT=3003

DATABASE_URL=postgres://wichat:wichat@localhost:5432/wichat?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MS_USER_HOST=localhost:3001

KAFKA_BROKERS=localhost:9092
KAFKA_CHAT_EVENTS_TOPIC=chat-events

# LiveKit (Cloud Build/Ship or local deploy/compose/livekit.yml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretdevkey1234567890abcdef1234567890
LIVEKIT_MONTHLY_QUOTA_MINUTES=5000
LIVEKIT_ENFORCE_HARD_CAP=false

# MinIO (call recordings via LiveKit Egress)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=wichat
MINIO_SECRET_KEY=wichatdev
MINIO_BUCKET=wichat-public
MINIO_PUBLIC_BASE_URL=http://localhost:9000/wichat-public
MINIO_USE_SSL=false
MINIO_REGION=
