# ms-user — copy to .env in this directory (see backend/README.md)
ENV=development
LOG_LEVEL=info
PORT=3001

DATABASE_URL=postgres://wichat:wichat@localhost:5432/wichat?sslmode=disable

# Required. Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=

# Google OAuth — Authorized redirect URIs in GCP must match GOOGLE_REDIRECT_URL exactly (port 3000).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google

# Match host port from deploy compose (default 6379; some local stacks use 4379)
REDIS_URL=redis://localhost:6379/0
MS_NOTIFICATION_HOST=localhost:3005

# Optional — group icons (public bucket). Leave MINIO_ENDPOINT empty to disable uploads.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=wichat
# MINIO_SECRET_KEY=wichatdev
# MINIO_BUCKET=wichat-public
# MINIO_PUBLIC_BASE_URL=http://localhost:9000/wichat-public
# MINIO_USE_SSL=false
# MINIO_REGION=

# Public web origin for invite links in email (match api-gateway WEB_ORIGIN / Next dev URL).
WEB_ORIGIN=http://localhost:8080
