# web-client — copy to .env.local (Next.js loads automatically)
# Public vars only — no secrets in NEXT_PUBLIC_*.
#
# Dev UI: pnpm dev → http://localhost:8080
# API: api-gateway default http://localhost:3000

# Dev with `next dev` (rewrites /api → gateway): use web origin so calls are same-origin (no CORS).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional upstream when not using default 127.0.0.1:3000 (see next.config.ts).
# API_GATEWAY_PROXY_TARGET=http://127.0.0.1:3000

# MinIO public bucket — required for next/image on group icons (see next.config.ts remotePatterns)
NEXT_PUBLIC_OBJECT_PUBLIC_BASE_URL=http://localhost:9000/wichat-public

# Static chat shell mock (fixture workspace): http://localhost:8080/dev/chat-ui
