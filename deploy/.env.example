# Deploy / Docker Compose — optional overrides (not loaded automatically).
# Usage when needed:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# Defaults are in deploy/compose/*.yml today. Uncomment to override.

# POSTGRES_USER=wichat
# POSTGRES_PASSWORD=wichat
# POSTGRES_DB=wichat

# Dev connection strings (copy into backend/ms-*/.env when a service uses DB/Redis):
# DATABASE_URL=postgres://wichat:wichat@localhost:5432/wichat?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
