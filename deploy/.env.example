# Deploy / Docker Compose — optional overrides (not loaded automatically).
# Usage when needed:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# Defaults are in deploy/compose/*.yml today. Uncomment to override.

# POSTGRES_USER=wichat
# POSTGRES_PASSWORD=wichat
# POSTGRES_DB=wichat

# Dev connection strings (copy into backend/ms-*/.env when a service uses DB/Redis):
# DATABASE_URL=postgres://wichat:wichat@localhost:5432/wichat?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

# Event backbone + search (after `docker compose -f deploy/docker-compose.yml up -d`):
# KAFKA_BROKERS=localhost:9092
# KAFKA_CHAT_EVENTS_TOPIC=chat-events
# ELASTICSEARCH_URL=http://localhost:9200

# LiveKit (Cloud Build/Ship or local deploy/compose/livekit.yml):
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secretdevkey1234567890abcdef1234567890
# LIVEKIT_MONTHLY_QUOTA_MINUTES=5000
# LIVEKIT_ENFORCE_HARD_CAP=false
